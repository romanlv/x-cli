#!/usr/bin/env bash
#
# Launcher for the x CLI. Run from anywhere, or symlink onto PATH:
#
#   ln -s "$PWD/bin/x" ~/bin/x
#
# Resolves symlinks first so a linked path still finds the checkout, and runs bun on the entry
# point without cd-ing, so relative arguments such as a file path stay the caller's.
set -euo pipefail

src="${BASH_SOURCE[0]}"
while [[ -L "$src" ]]; do
  dir="$(cd -P -- "$(dirname -- "$src")" && pwd)"
  src="$(readlink -- "$src")"
  [[ "$src" != /* ]] && src="$dir/$src"
done
root="$(cd -P -- "$(dirname -- "$src")/.." && pwd)"

if [[ ! -d "$root/node_modules/playwright" ]]; then
  printf 'x: dependencies missing\n  run `bun install` in %s first\n' "$root" >&2
  exit 3
fi

exec bun "$root/x/main.ts" "$@"
